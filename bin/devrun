#!/usr/bin/env lua

local devrun = {}

local function getenv(name, fallback)
  local value = os.getenv(name)
  if value == nil or value == "" then
    return fallback
  end
  return value
end

local function getenv_integer(name, fallback)
  local value = getenv(name, tostring(fallback))
  if value:match("^%d+$") then
    return tonumber(value)
  end
  return value
end

local function account_name(username)
  if type(username) == "string" and username:match("^[a-z_][a-z0-9_-]*$") then
    return username
  end
  return "devuser"
end

-- User-editable policy: profiles express portable launch intent, while ordered
-- image mappings select profile sets and supply image-specific account details.
devrun.config = {
  engine = nil,
  defaults = {
    home_volume = "devrun",
    container_user = "devuser",
    container_home = "/home/devuser",
    timezone = getenv("DEVRUN_TIMEZONE", "America/Los_Angeles"),
    ssh_port = getenv_integer("DEVRUN_SSH_HOST_PORT", 3322),
    rdp_port = getenv_integer("DEVRUN_RDP_HOST_PORT", 3389),
    network = getenv("DEVRUN_NETWORK", "my-net"),
    connext_version = getenv("DEVRUN_CONNEXT_VERSION", "7.7.0"),
    license_file = getenv(
      "DEVRUN_RTI_LICENSE_FILE",
      getenv("HOME", "") .. "/rti/licenses/rti_license.dat"
    ),
  },
  default_profiles = { "dev", "identity" },
  profiles = {
    dev = function(ctx)
      return {
        interactive = true,
        remove = true,
        mounts = {
          { source = ctx.cwd, target = "/workspace", relabel = "private" },
        },
        home_volume = ctx.config.defaults.home_volume,
        optional_home_mounts = {
          readonly = {
            ".bash_logout",
            ".bashrc",
            ".config/kitty/",
            ".config/lazygit/",
            ".config/mise/",
            ".config/nvim/",
            ".config/opencode/",
            ".config/starship.toml",
            ".gitconfig",
            ".gitignore",
            ".gitignore_global",
            ".clangd",
            ".markdownlint.yaml",
            ".profile",
            ".scripts/",
            ".vscode/mcp.json",
            "tools/",
          },
          writable = {
            ".config/nvim/lazy-lock.json",
          },
        },
        workdir = "/workspace",
        container_user = ctx.config.defaults.container_user,
        container_home = ctx.config.defaults.container_home,
        command = { "/bin/bash" },
        env = {
          TERM = ctx.env.TERM,
          TZ = ctx.config.defaults.timezone,
        },
      }
    end,
    identity = function(ctx)
      return {
        map_host_identity = true,
        container_user = ctx.config.defaults.container_user,
        container_home = ctx.config.defaults.container_home,
      }
    end,
    gui = function(ctx)
      return {
        detached = true,
        remove = true,
        mounts = {
          { source = ctx.cwd, target = "/workspace", relabel = "private" },
        },
        workdir = "/workspace",
        shm_size = "2g",
        env = { TZ = ctx.config.defaults.timezone },
        ports = {
          { host = ctx.config.defaults.ssh_port, container = 3322, protocol = "tcp" },
          { host = ctx.config.defaults.rdp_port, container = 3389, protocol = "tcp" },
        },
      }
    end,
    connext = function(ctx)
      local version = ctx.config.defaults.connext_version
      local license_file = ctx.config.defaults.license_file
      return {
        ensure_network = ctx.config.defaults.network,
        network = ctx.config.defaults.network,
        optional_mounts = {
          {
            source = license_file,
            target = "/opt/rti.com/rti_connext_dds-" .. version .. "/rti_license.dat",
            readonly = true,
            relabel = "shared",
            missing_message = "RTI license file does not exist; continuing without mount: "
              .. license_file,
          },
        },
      }
    end,
  },
  images = {
    -- The left frontier means start of string or immediately after "/".
    {
      pattern = "%f[^/%z]rticom/connext%-sdk%f[:@%z]",
      profiles = { "dev", "identity", "connext" },
      overrides = {},
    },
    {
      pattern = "%f[^/%z]connext%-sdk%-dev%f[:@%z]",
      profiles = { "dev", "identity", "connext" },
      overrides = {},
    },
    {
      pattern = "%f[^/%z]connext%-tools%f[:@%z]",
      profiles = { "gui", "connext" },
      overrides = { container_home = "/home/user" },
    },
    {
      pattern = "%f[^/%z]hectorm/xubuntu%f[:@%z]",
      profiles = { "gui" },
      overrides = {},
    },
  },
}

local usage = [[Usage: devrun IMAGE [OPTIONS]

Options:
  -p, --profile NAME   Select a profile; may be repeated
      --name NAME      Override the generated container name
      --engine ENGINE  Select docker or podman
      --dry-run        Print the quoted container command
  -h, --help           Show this help
]]

local function fail(message, level)
  error(message, (level or 1) + 1)
end

function devrun.parse_args(arguments)
  local options = { profiles = {}, dry_run = false, help = false }
  local index = 1

  while index <= #arguments do
    local value = arguments[index]
    if value == "-h" or value == "--help" then
      options.help = true
    elseif value == "--dry-run" then
      options.dry_run = true
    elseif value == "-p" or value == "--profile" then
      index = index + 1
      if not arguments[index] then
        fail(value .. " requires a profile name", 1)
      end
      options.profiles[#options.profiles + 1] = arguments[index]
    elseif value == "--name" or value == "--engine" then
      index = index + 1
      if not arguments[index] then
        fail(value .. " requires a value", 1)
      end
      options[value == "--name" and "name" or "engine"] = arguments[index]
    elseif value:sub(1, 1) == "-" then
      fail("unknown option: " .. value, 1)
    elseif options.image then
      fail("unexpected argument: " .. value, 1)
    else
      options.image = value
    end
    index = index + 1
  end

  if not options.image and not options.help then
    fail("IMAGE is required", 1)
  end
  if options.engine and options.engine ~= "docker" and options.engine ~= "podman" then
    fail("engine must be docker or podman", 1)
  end
  return options
end

local function copy_list(values)
  local result = {}
  for index, value in ipairs(values or {}) do
    result[index] = value
  end
  return result
end

local function matching_image(image, config)
  -- First match wins; keep image rules in an array so precedence is explicit.
  for _, mapping in ipairs(config.images or {}) do
    local matches = mapping.exact and image == mapping.exact
      or mapping.pattern and image:match(mapping.pattern)
    if matches then
      return mapping
    end
  end
  return nil
end

function devrun.select_profiles(options, config)
  -- Explicit profiles replace, rather than extend, image-derived policy.
  if #options.profiles > 0 then
    return copy_list(options.profiles)
  end
  local mapping = matching_image(options.image, config)
  if mapping then
    return copy_list(mapping.profiles)
  end
  return copy_list(config.default_profiles)
end

local list_fields = {
  mounts = true,
  optional_mounts = true,
  ports = true,
  run_args = true,
  command = true,
}

local keyed_fields = { env = true }

local function append_mounts(target, mounts)
  -- Mount destinations are unique: a later profile replaces the earlier source
  -- and options for that destination instead of creating ambiguous mounts.
  target.mounts = target.mounts or {}
  for _, mount in ipairs(mounts) do
    local replaced = false
    if mount.target then
      for index, existing in ipairs(target.mounts) do
        if existing.target == mount.target then
          target.mounts[index] = mount
          replaced = true
          break
        end
      end
    end
    if not replaced then target.mounts[#target.mounts + 1] = mount end
  end
end

local function merge(target, source)
  -- Profiles merge in selection order: scalars and keyed values use the later
  -- value, while ordinary lists append to preserve each profile's arguments.
  for key, value in pairs(source or {}) do
    if key == "mounts" then
      append_mounts(target, value)
    elseif list_fields[key] then
      target[key] = target[key] or {}
      for _, item in ipairs(value) do
        target[key][#target[key] + 1] = item
      end
    elseif keyed_fields[key] then
      target[key] = target[key] or {}
      for item_key, item_value in pairs(value) do
        target[key][item_key] = item_value
      end
    else
      target[key] = value
    end
  end
  return target
end

function devrun.resolve_profiles(names, config, context)
  local resolved = {}
  for _, name in ipairs(names) do
    local profile = config.profiles[name]
    if not profile then
      fail("unknown profile: " .. name, 1)
    end
    if type(profile) == "function" then
      profile = profile(context)
    end
    merge(resolved, profile)
    if resolved.map_host_identity
        and not context.host_identity
        and context.resolve_host_identity then
      context.resolve_host_identity()
    end
  end
  return resolved
end

function devrun.resolve_launch(options, config, context)
  -- Build the engine-neutral launch model before optional paths and adapter
  -- details are resolved. Mapping overrides apply only to automatic selection.
  context.config = config
  context.image = options.image
  local profiles = devrun.select_profiles(options, config)
  local resolved = devrun.resolve_profiles(profiles, config, context)
  local mapping = matching_image(options.image, config)
  if #options.profiles == 0 and mapping then
    merge(resolved, mapping.overrides)
  end
  if resolved.home_volume and resolved.container_home then
    -- A named home volume persists tool state; ownership is an adapter request,
    -- not a request to alter ownership of bind-mounted host paths.
    append_mounts(resolved, { {
      source = resolved.home_volume,
      target = resolved.container_home,
      ownership = true,
      relabel = "shared",
    } })
  end
  for _, group in ipairs({ "readonly", "writable" }) do
    for index, path in ipairs((resolved.optional_home_mounts or {})[group] or {}) do
      local description = "optional_home_mounts." .. group .. "[" .. index .. "]"
      if type(path) ~= "string" then
        fail(description .. " must be a relative path string", 1)
      end
      if path == "" or path:sub(1, 1) == "/" then
        fail(description .. " must be a non-empty relative path", 1)
      end
      for component in path:gmatch("[^/]+") do
        if component == "." or component == ".." then
          fail(description .. " must not contain '.' or '..' path components", 1)
        end
      end
      resolved.optional_mounts = resolved.optional_mounts or {}
      resolved.optional_mounts[#resolved.optional_mounts + 1] = {
        source = context.home .. "/" .. path,
        target = resolved.container_home and (resolved.container_home .. "/" .. path),
        readonly = group == "readonly",
        relabel = "shared",
      }
    end
  end
  resolved.profiles = profiles
  return resolved
end

local function basename(path)
  local trimmed = path:gsub("/+$", "")
  return trimmed:match("([^/]+)$") or "workspace"
end

function devrun.container_name(cwd, image)
  local repository = image:gsub("@.*$", ""):gsub(":([^/]*)$", "")
  local raw = basename(cwd) .. "-" .. basename(repository)
  local name = raw:lower():gsub("[^a-z0-9_.-]+", "-"):gsub("[-_.]+", "-")
  name = name:gsub("^-+", ""):gsub("-+$", ""):sub(1, 63):gsub("-+$", "")
  if name == "" then
    return "devrun"
  end
  return name
end

function devrun.shell_quote(value)
  -- os.execute has no argv form in standard Lua. Reject line boundaries, then
  -- encode every argument as one POSIX-shell word before execution or display.
  value = tostring(value)
  if value:find("[%z\r\n]") then
    fail("command arguments may not contain NUL or newlines", 1)
  end
  return "'" .. value:gsub("'", "'\"'\"'") .. "'"
end

local function append(arguments, ...)
  for index = 1, select("#", ...) do
    arguments[#arguments + 1] = select(index, ...)
  end
end

local function validate_port(value, description)
  if type(value) ~= "number" or value % 1 ~= 0 or value < 1 or value > 65535 then
    fail(description .. " must be an integer in 1..65535 (got " .. tostring(value) .. ")", 2)
  end
end

function devrun.validate_launch(launch)
  for index, port in ipairs(launch.ports or {}) do
    if type(port) ~= "table" then
      fail("port " .. index .. " must be a table", 1)
    end
    validate_port(port.host, "port " .. index .. " host port")
    validate_port(port.container, "port " .. index .. " container port")
    if port.protocol ~= "tcp" and port.protocol ~= "udp" then
      fail("port " .. index .. " protocol must be tcp or udp (got "
        .. tostring(port.protocol) .. ")", 1)
    end
  end
  return launch
end

function devrun.build_command(options, launch, context)
  local engine = options.engine or context.engine or launch.engine
  if not engine then
    fail("container engine has not been selected", 1)
  end
  devrun.validate_launch(launch)

  local arguments = { engine, "run" }
  if launch.remove then append(arguments, "--rm") end
  if launch.interactive then append(arguments, "-it") end
  if launch.detached then append(arguments, "-d") end
  append(arguments, "--name", options.name or devrun.container_name(context.cwd, options.image))

  if launch.map_host_identity then
    local host_identity = context.host_identity
    if not host_identity then
      fail("host identity has not been resolved", 1)
    end
    local username = launch.container_user or account_name(host_identity.username)
    local container_home = launch.container_home or context.home
    append(arguments, "--user", host_identity.uid .. ":" .. host_identity.gid)
    -- Podman can map the host IDs into a user namespace and synthesize passwd
    -- metadata. Docker's portable equivalent is only the numeric --user pair.
    if engine == "podman" then
      append(arguments, "--userns=keep-id")
      append(arguments, "--passwd-entry",
        username .. ":x:" .. host_identity.uid .. ":" .. host_identity.gid
          .. ":" .. username .. ":" .. container_home .. ":/bin/bash")
    end
  end

  if launch.workdir then append(arguments, "-w", launch.workdir) end
  if launch.network then append(arguments, "--network", launch.network) end
  if launch.shm_size then append(arguments, "--shm-size", launch.shm_size) end
  for _, port in ipairs(launch.ports or {}) do
    append(arguments, "--publish",
      port.host .. ":" .. port.container .. "/" .. port.protocol)
  end
  for _, mount in ipairs(launch.mounts or {}) do
    local specification = mount.source .. ":" .. mount.target
    local options = {}
    if mount.readonly then options[#options + 1] = "ro" end
    -- Podman's U applies ownership to named-volume contents. Z/z relabel
    -- volume sources for private/shared SELinux use; Docker receives neither.
    if mount.ownership and engine == "podman" then options[#options + 1] = "U" end
    if mount.relabel == "private" and engine == "podman" then options[#options + 1] = "Z" end
    if mount.relabel == "shared" and engine == "podman" then options[#options + 1] = "z" end
    if #options > 0 then specification = specification .. ":" .. table.concat(options, ",") end
    append(arguments, "-v", specification)
  end
  local env_keys = {}
  if launch.map_host_identity then
    launch.env = launch.env or {}
    local username = launch.container_user or account_name(context.host_identity.username)
    launch.env.USER = username
    launch.env.LOGNAME = username
    launch.env.HOME = launch.container_home or context.home
  end
  for key, value in pairs(launch.env or {}) do
    if value ~= nil then env_keys[#env_keys + 1] = key end
  end
  table.sort(env_keys)
  for _, key in ipairs(env_keys) do
    append(arguments, "-e", key .. "=" .. tostring(launch.env[key]))
  end
  for _, value in ipairs(launch.run_args or {}) do append(arguments, value) end
  append(arguments, options.image)
  for _, value in ipairs(launch.command or {}) do append(arguments, value) end
  return arguments
end

function devrun.render_command(arguments)
  -- This is the single argv-to-shell boundary used by dry runs and execution.
  local quoted = {}
  for index, value in ipairs(arguments) do
    quoted[index] = devrun.shell_quote(value)
  end
  return table.concat(quoted, " ")
end

function devrun.filter_optional_mounts(launch, path_exists, warn)
  for _, mount in ipairs(launch.optional_mounts or {}) do
    if mount.target and path_exists(mount.source) then
      append_mounts(launch, { mount })
    else
      warn(mount.missing_message or ("optional host path does not exist; skipping " .. mount.source))
    end
  end
  return launch
end

local function process_status(first, reason, code)
  if first == true then return 0 end
  if type(first) == "number" then
    if first > 255 then return math.floor(first / 256) end
    return first
  end
  if reason == "exit" and type(code) == "number" then return code end
  if reason == "signal" and type(code) == "number" then return 128 + code end
  return 1
end

function devrun.execute(arguments, execute)
  return process_status(execute(devrun.render_command(arguments)))
end

local function print_detached_details(stdout, name, launch)
  local details = { "Container: " .. name }
  for _, port in ipairs(launch.ports or {}) do
    if port.container == 3322 and port.protocol == "tcp" then
      details[#details + 1] = "SSH: localhost:" .. port.host
    elseif port.container == 3389 and port.protocol == "tcp" then
      details[#details + 1] = "RDP: localhost:" .. port.host
    end
  end
  stdout(table.concat(details, "\n") .. "\n")
end

local function capture_command(arguments)
  local pipe, open_error = io.popen(devrun.render_command(arguments) .. " 2>&1", "r")
  if not pipe then return 1, tostring(open_error) end
  local output = pipe:read("*a")
  local first, reason, code = pipe:close()
  return process_status(first, reason, code), output
end

function devrun.network_commands(engine, network)
  return
    { engine, "network", "ls", "--format", "{{.Name}}" },
    { engine, "network", "create", "--driver", "bridge", network }
end

function devrun.ensure_network(engine, network, capture, execute)
  -- Listing names distinguishes an absent network from an inspection failure;
  -- only absence permits creation, so permission/daemon errors are not masked.
  local inspect, create = devrun.network_commands(engine, network)
  local status, output = capture(inspect)
  if status ~= 0 then
    return false, "failed to inspect networks with " .. devrun.render_command(inspect)
      .. " (exit " .. status .. ")" .. (output ~= "" and ": " .. output:gsub("%s+$", "") or "")
  end
  for existing in (output .. "\n"):gmatch("([^\r\n]*)\r?\n") do
    if existing == network then return true end
  end
  status = devrun.execute(create, execute)
  if status ~= 0 then
    return false, "failed to create network " .. devrun.shell_quote(network)
      .. " with bridge driver (exit " .. status .. ")"
  end
  return true
end

function devrun.container_exists(engine, name, execute)
  local command = devrun.render_command({ engine, "container", "inspect", name })
    .. " >/dev/null 2>&1"
  return process_status(execute(command)) == 0
end

local function command_exists(command)
  local result = os.execute("command -v " .. devrun.shell_quote(command) .. " >/dev/null 2>&1")
  return result == true or result == 0
end

local function select_engine(options, config)
  if options.engine then return options.engine end
  if config.engine then return config.engine end
  if command_exists("podman") then return "podman" end
  if command_exists("docker") then return "docker" end
  fail("neither podman nor docker was found", 1)
end

local function current_directory()
  local pipe = assert(io.popen("pwd", "r"))
  local cwd = assert(pipe:read("*l"))
  pipe:close()
  return cwd
end

local function read_command_line(command)
  local pipe = assert(io.popen(command, "r"))
  local value = assert(pipe:read("*l"))
  assert(pipe:close())
  return value
end

local function host_identity()
  return {
    uid = read_command_line("id -u"),
    gid = read_command_line("id -g"),
    username = read_command_line("id -un"),
  }
end

local function path_exists(path)
  local ok, _, code = os.rename(path, path)
  return ok or code == 13
end

function devrun.run(arguments, dependencies)
  -- Orchestrate without container-engine mutations until the launch model and
  -- command are valid: parse, resolve context/profiles, filter optional mounts,
  -- then render. Real launches refuse name collisions and ensure networking.
  dependencies = dependencies or {}
  local stdout = dependencies.stdout or function(value) io.stdout:write(value) end
  local stderr = dependencies.stderr or function(value) io.stderr:write(value) end
  local execute = dependencies.execute or os.execute
  local capture = dependencies.capture or capture_command
  local ok, options = pcall(devrun.parse_args, arguments)
  if not ok then
    stderr("devrun: " .. tostring(options) .. "\n")
    stderr("Try 'devrun --help' for usage.\n")
    return 2
  end
  if options.help then
    stdout(usage)
    return 0
  end

  local context = {
    cwd = dependencies.cwd or current_directory(),
    home = getenv("HOME", ""),
    username = getenv("USER", nil),
    env = { TERM = os.getenv("TERM") },
    engine = select_engine(options, devrun.config),
  }
  context.environment = context.env
  -- Resolve identity when profile intent requests it, regardless of the
  -- profile's name. Profiles applied afterward can consume the direct fields.
  context.resolve_host_identity = function()
    context.host_identity = (dependencies.host_identity or host_identity)()
    context.username = context.host_identity.username
    context.uid = context.host_identity.uid
    context.gid = context.host_identity.gid
  end
  local resolved_ok, launch = pcall(devrun.resolve_launch, options, devrun.config, context)
  if not resolved_ok then
    stderr("devrun: " .. tostring(launch) .. "\n")
    return 2
  end
  devrun.filter_optional_mounts(
    launch,
    dependencies.path_exists or path_exists,
    function(message) stderr("devrun: warning: " .. message .. "\n") end
  )
  local command_ok, command, rendered_command = pcall(function()
    local built_command = devrun.build_command(options, launch, context)
    return built_command, devrun.render_command(built_command)
  end)
  if not command_ok then
    stderr("devrun: " .. tostring(command) .. "\n")
    return 2
  end
  if options.dry_run then
    -- Describe conditional network setup without inspecting or changing it.
    if launch.ensure_network then
      local inspect, create = devrun.network_commands(context.engine, launch.ensure_network)
      stdout("# ensure network " .. devrun.shell_quote(launch.ensure_network) .. " exists\n")
      stdout("# inspect: " .. devrun.render_command(inspect) .. "\n")
      stdout("# if absent: " .. devrun.render_command(create) .. "\n")
    end
    stdout(rendered_command .. "\n")
    return 0
  end

  local name = options.name or devrun.container_name(context.cwd, options.image)
  if devrun.container_exists(context.engine, name, execute) then
    stderr("devrun: container '" .. name .. "' already exists; choose another --name"
      .. " or remove it explicitly with "
      .. devrun.render_command({ context.engine, "rm", name }) .. "\n")
    return 2
  end
  if launch.ensure_network then
    local network_ok, network_error = devrun.ensure_network(
      context.engine, launch.ensure_network, capture, execute
    )
    if not network_ok then
      stderr("devrun: " .. network_error .. "\n")
      return 1
    end
  end
  local status = process_status(execute(rendered_command))
  if status == 0 and launch.detached then
    print_detached_details(stdout, name, launch)
  end
  return status
end

if not _G.DEVRUN_TESTING then
  os.exit(devrun.run(arg))
end

return devrun
